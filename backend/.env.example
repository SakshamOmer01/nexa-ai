# ---------------------------------------------------------------------------
# Nexa AI — backend environment template
# Copy to `backend/.env` for local development: cp .env.example .env
# Never commit a real .env. Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------

# --- Service ---------------------------------------------------------------
APP_NAME="Nexa AI API"
ENVIRONMENT=development          # development | test | staging | production
DEBUG=true
LOG_LEVEL=INFO                   # CRITICAL | ERROR | WARNING | INFO | DEBUG
API_V1_PREFIX=/api/v1
# DOCS_ENABLED=                  # unset = enabled except in production

# --- Security --------------------------------------------------------------
# SECRET_KEY signs every JWT access token: 32+ unique characters in production.
# Rotating it immediately invalidates all issued tokens.
SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
# Session/token lifetime in minutes (default 30).
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Passwords are hashed with Argon2id. Signup requires 8-128 characters; emails are
# stored lower-cased so uniqueness is case-insensitive.

# --- PostgreSQL ------------------------------------------------------------
# The async driver (`+asyncpg`) is required.
DATABASE_URL=postgresql+asyncpg://nexa:nexa_dev_password@localhost:5432/nexa
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_ECHO=false

# --- HTTP ------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
