# ---------------------------------------------------------------------------
# Nexa AI — local stack environment template
#
#   cp .env.example .env
#
# Used by docker compose. Generate a real secret for anything beyond local use:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit .env.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=development          # development | test | staging | production
DEBUG=false
LOG_LEVEL=INFO

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=nexa
POSTGRES_PASSWORD=nexa_dev_password
POSTGRES_DB=nexa
POSTGRES_PORT=5432

# --- Backend ---------------------------------------------------------------
BACKEND_PORT=8000
# Signs JWT access tokens. Rotating it invalidates every existing session.
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh-token family lifetime in days; logout or replay detection revokes it earlier.
REFRESH_TOKEN_EXPIRE_DAYS=30
# Credential-endpoint rate limiting (login, signup, refresh), per identity and per API process.
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_APP_NAME="Nexa AI"
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
