# ---------------------------------------------------------------------------
# Nexa AI — ML workspace environment template
# All variables are prefixed with NEXA_ML_ so they can share an environment
# with the API. Copy to `ml/.env` if you need local overrides.
# ---------------------------------------------------------------------------

NEXA_ML_ENVIRONMENT=development
NEXA_ML_MODEL_DIR=artifacts
NEXA_ML_DEVICE=cpu                 # cpu | cuda | mps
NEXA_ML_MAX_BATCH_SIZE=32
NEXA_ML_RANDOM_SEED=1337
