# ---------------------------------------------------------------------------
# Nexa AI — frontend environment template
# Copy to `frontend/.env.local` for local development: cp .env.example .env.local
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time:
# never put secrets here.
# ---------------------------------------------------------------------------

# Public brand + version surfaced in metadata and the health payload.
NEXT_PUBLIC_APP_NAME="Nexa AI"
NEXT_PUBLIC_APP_VERSION=0.1.0

# Public origin of the API (used by browser-side calls and docs links).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public origin of this web app (canonical/OpenGraph metadata).
# Authentication: when this value is an https origin, the access-token cookie is also marked
# Secure. It is inlined at build time, so rebuild after changing it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: reach the API from inside the Docker network or a private VPC.
# Leave unset locally so server-side calls fall back to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://backend:8000/api/v1
